// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VENDEDOR
}

enum MotorcycleStatus {
  DISPONIBLE
  RESERVADA
  VENDIDA
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  FINANCIADO
  MIXTO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  sales        Sale[]
}

model Client {
  id        String   @id @default(cuid())
  name      String
  document  String?  @unique
  phone     String?
  address   String?
  email     String?
  createdAt DateTime @default(now())

  motorcyclesSupplied Motorcycle[] @relation("SupplierClient")
  purchases           Sale[]       @relation("BuyerClient")
}

model Motorcycle {
  id             String           @id @default(cuid())
  brand          String
  model          String
  year           Int
  displacementCc Int
  plate          String           @unique
  chassisNumber  String           @unique
  engineNumber   String?
  color          String?
  mileageKm      Int?
  purchasePrice  Decimal?         @db.Decimal(12, 2)
  salePrice      Decimal          @db.Decimal(12, 2)
  status         MotorcycleStatus @default(DISPONIBLE)
  description    String?
  acquiredAt     DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  supplierId String?
  supplier   Client? @relation("SupplierClient", fields: [supplierId], references: [id])

  photos Photo[]
  sale   Sale?
}

model Photo {
  id           String     @id @default(cuid())
  url          String
  order        Int        @default(0)
  motorcycleId String
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)
}

model Sale {
  id            String        @id @default(cuid())
  motorcycleId  String        @unique
  motorcycle    Motorcycle    @relation(fields: [motorcycleId], references: [id])
  buyerId       String
  buyer         Client        @relation("BuyerClient", fields: [buyerId], references: [id])
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])
  finalPrice    Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(EFECTIVO)
  soldAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
}
